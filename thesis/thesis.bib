}
@article{Wu2023,
   abstract = {Differential scanning fluorimetry (DSF) is a widely used technique for determining the apparent melting temperature (Tma) of a purified protein. Here, we present a protocol for performing and optimizing DSF experiments. We describe steps for designing and performing the experiment, analyzing data, and optimization. We provide benchmarks for typical Tmas and ΔTmas, standard assay conditions, and upper and lower limits of commonly altered experimental variables. We also detail common pitfalls of DSF and ways to avoid, identify, and overcome them.},
